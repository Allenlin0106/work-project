@model ProjectPlanning.Entities.Dtos.ProjectEditDto
@{ ViewBag.Title = "建立專案"; }

<h2>建立專案</h2>
@using (Html.BeginForm())
{
    @Html.AntiForgeryToken()
    <div>@Html.LabelFor(m => m.Name) @Html.TextBoxFor(m => m.Name) @Html.ValidationMessageFor(m => m.Name)</div>
    <div>@Html.LabelFor(m => m.Description) @Html.TextAreaFor(m => m.Description, new { rows = 4, cols = 60 })</div>
    <div>@Html.LabelFor(m => m.StartDate) @Html.TextBoxFor(m => m.StartDate, "{0:yyyy-MM-dd}", new { type = "date" })</div>
    <div>@Html.LabelFor(m => m.EndDate) @Html.TextBoxFor(m => m.EndDate, "{0:yyyy-MM-dd}", new { type = "date" })</div>
    <div>@Html.LabelFor(m => m.Status) @Html.EnumDropDownListFor(m => m.Status)</div>
    <div style="margin-top:12px"><button type="submit" class="btn">建立</button>
    @Html.ActionLink("取消", "Index", null, new { @class = "btn secondary" })</div>
}
