@model IEnumerable<ProjectPlanning.Entities.Dtos.ProjectListDto>
@{ ViewBag.Title = "專案列表"; }

<h2>專案列表</h2>
<div class="toolbar">
    @Html.ActionLink("新增專案", "Create", null, new { @class = "btn" })
</div>

<table class="data">
    <thead>
        <tr>
            <th>名稱</th><th>狀態</th><th>開始</th><th>結束</th><th>任務數</th><th>成員數</th><th>負責人</th><th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@Html.ActionLink(p.Name, "Details", new { id = p.Id })</td>
            <td>@p.Status</td>
            <td>@p.StartDate.ToString("yyyy-MM-dd")</td>
            <td>@p.EndDate.ToString("yyyy-MM-dd")</td>
            <td>@p.TaskCount</td>
            <td>@p.MemberCount</td>
            <td>@p.OwnerDisplayName</td>
            <td>
                @Html.ActionLink("甘特圖", "Index", "Gantt", new { projectId = p.Id }, new { @class = "btn secondary" })
            </td>
        </tr>
    }
    </tbody>
</table>
