<!DOCTYPE html>
<html lang="zh-Hant">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - 專案進度規劃系統</title>
    <link href="@Url.Content("~/Content/gantt/gantt.css")" rel="stylesheet" />
    <style>
        body { font-family: "Segoe UI", "Microsoft JhengHei", sans-serif; margin: 0; background: #f6f7f9; color: #222; }
        header { background: #1f3a68; color: #fff; padding: 12px 24px; display: flex; align-items: center; justify-content: space-between; }
        header a { color: #fff; text-decoration: none; margin-right: 16px; }
        header a:hover { text-decoration: underline; }
        main { padding: 24px; }
        table.data { width: 100%; border-collapse: collapse; background: #fff; }
        table.data th, table.data td { border: 1px solid #dde2ea; padding: 6px 10px; text-align: left; vertical-align: top; }
        table.data th { background: #eef2f8; }
        .btn { display: inline-block; padding: 6px 12px; background: #1f3a68; color: #fff; border: 0; border-radius: 3px; cursor: pointer; text-decoration: none; }
        .btn.secondary { background: #6b7a90; }
        .btn.danger { background: #b3261e; }
        form.inline { display: inline; }
        .toolbar { margin-bottom: 12px; }
        @@media print { header, .no-print { display: none !important; } main { padding: 0; } }
    </style>
</head>
<body>
    <header class="no-print">
        <div>
            <strong>專案進度規劃系統</strong>
            <span style="margin-left:24px">
                @Html.ActionLink("專案", "Index", "Projects")
                @Html.ActionLink("軌跡查詢", "Index", "AuditLogs")
            </span>
        </div>
        <div>@User.Identity.Name</div>
    </header>
    <main>
        @RenderBody()
    </main>
    <script src="@Url.Content("~/Scripts/gantt/gantt.js")"></script>
    @RenderSection("scripts", required: false)
</body>
</html>
