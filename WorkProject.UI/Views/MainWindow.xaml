<Window x:Class="WorkProject.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WorkProject.UI.ViewModels"
        xmlns:views="clr-namespace:WorkProject.UI.Views"
        Title="WorkProject"
        Width="1200" Height="780"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:ProjectListViewModel}">
            <views:ProjectListView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuditLogViewModel}">
            <views:AuditLogView/>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#FF1E5685" Padding="12,8">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <TextBlock Text="WorkProject" Foreground="White" FontSize="16" FontWeight="Bold" Margin="0,0,16,0"/>
                    <Button Content="Projects" Command="{Binding ShowProjectsCommand}" Margin="4,0"/>
                    <Button Content="Audit Log" Command="{Binding ShowAuditCommand}" Margin="4,0"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <TextBlock Text="{Binding CurrentUserName}" Foreground="White" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <Button Content="Logout" Command="{Binding LogoutCommand}"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <ContentControl Grid.Row="1" Content="{Binding CurrentView}"/>
    </Grid>
</Window>
