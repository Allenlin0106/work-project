<UserControl x:Class="WorkProject.UI.Views.ProjectListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:WorkProject.UI.ViewModels"
             xmlns:views="clr-namespace:WorkProject.UI.Views">
    <UserControl.Resources>
        <DataTemplate DataType="{x:Type vm:ProjectDetailViewModel}">
            <views:ProjectDetailView/>
        </DataTemplate>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="340"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" BorderBrush="#FFCCCCCC" BorderThickness="0,0,1,0">
            <Grid Margin="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <DockPanel Grid.Row="0" LastChildFill="False">
                    <TextBlock Text="My Projects" FontWeight="Bold" FontSize="14" DockPanel.Dock="Left"/>
                    <Button Content="Refresh" Command="{Binding RefreshCommand}" DockPanel.Dock="Right"/>
                </DockPanel>

                <ListBox Grid.Row="1" Margin="0,8" ItemsSource="{Binding Projects}"
                         SelectedItem="{Binding SelectedProject}"
                         MouseDoubleClick="OnProjectDoubleClick">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                <TextBlock FontSize="11" Foreground="Gray">
                                    <Run Text="{Binding StartDate, StringFormat=yyyy-MM-dd}"/>
                                    <Run Text=" - "/>
                                    <Run Text="{Binding EndDate, StringFormat=yyyy-MM-dd}"/>
                                    <Run Text=" | "/>
                                    <Run Text="{Binding TaskCount}"/>
                                    <Run Text=" tasks | "/>
                                    <Run Text="{Binding ProgressPercent, StringFormat={}{0:F0}%}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="2" Background="#FFF7F7F7" Padding="8" CornerRadius="4">
                    <StackPanel>
                        <TextBlock Text="New project" FontWeight="SemiBold"/>
                        <TextBox Text="{Binding NewProjectName, UpdateSourceTrigger=PropertyChanged}" Margin="0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker Grid.Column="0" SelectedDate="{Binding NewProjectStart}"/>
                            <DatePicker Grid.Column="1" SelectedDate="{Binding NewProjectEnd}" Margin="4,0,0,0"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                            <Button Content="Create" Command="{Binding CreateProjectCommand}"
                                    Style="{StaticResource PrimaryButton}" Width="90"/>
                            <Button Content="Delete" Command="{Binding DeleteProjectCommand}"
                                    Margin="6,0,0,0" Width="90"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <ContentControl Grid.Column="1" Content="{Binding DetailView}"/>
    </Grid>
</UserControl>
