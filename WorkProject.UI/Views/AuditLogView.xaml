<UserControl x:Class="WorkProject.UI.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="200"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#FFF7F7F7" Padding="8" CornerRadius="4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Entity type"/>
                    <TextBox Text="{Binding EntityType, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="4,0,0,0">
                    <TextBlock Text="Entity id"/>
                    <TextBox Text="{Binding EntityId, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="4,0,0,0">
                    <TextBlock Text="Action"/>
                    <TextBox Text="{Binding Action, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="4,0,0,0">
                    <TextBlock Text="From"/>
                    <DatePicker SelectedDate="{Binding FromDate}"/>
                </StackPanel>
                <StackPanel Grid.Column="4" Margin="4,0,0,0">
                    <TextBlock Text="To"/>
                    <DatePicker SelectedDate="{Binding ToDate}"/>
                </StackPanel>
                <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="8,0,0,0">
                    <Button Content="Search" Command="{Binding SearchCommand}" Style="{StaticResource PrimaryButton}" Width="80"/>
                    <Button Content="Clear" Command="{Binding ClearFiltersCommand}" Margin="6,0,0,0" Width="80"/>
                </StackPanel>
            </Grid>
        </Border>

        <DataGrid Grid.Row="1" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}"
                  AutoGenerateColumns="False" CanUserAddRows="False" IsReadOnly="True" Margin="0,8">
            <DataGrid.Columns>
                <DataGridTextColumn Header="When (UTC)" Binding="{Binding WhenUtc, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160"/>
                <DataGridTextColumn Header="Who" Binding="{Binding WhoDisplayName}" Width="140"/>
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="100"/>
                <DataGridTextColumn Header="Entity" Binding="{Binding EntityType}" Width="120"/>
                <DataGridTextColumn Header="Id" Binding="{Binding EntityId}" Width="80"/>
                <DataGridTextColumn Header="Correlation" Binding="{Binding CorrelationId}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <DockPanel Grid.Column="0">
                <TextBlock Text="Before" DockPanel.Dock="Top" FontWeight="Bold"/>
                <TextBox Text="{Binding Selected.BeforeJson, Mode=OneWay}" IsReadOnly="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
            <DockPanel Grid.Column="1" Margin="8,0,0,0">
                <TextBlock Text="After" DockPanel.Dock="Top" FontWeight="Bold"/>
                <TextBox Text="{Binding Selected.AfterJson, Mode=OneWay}" IsReadOnly="True"
                         TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
            </DockPanel>
        </Grid>
    </Grid>
</UserControl>
