<UserControl x:Class="WorkProject.UI.Controls.Gantt.GanttView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:gantt="clr-namespace:WorkProject.UI.Controls.Gantt"
             xmlns:conv="clr-namespace:WorkProject.UI.Converters"
             xmlns:vm="clr-namespace:WorkProject.UI.ViewModels"
             xmlns:beh="clr-namespace:WorkProject.UI.Behaviors">
    <UserControl.Resources>
        <conv:DateToPixelConverter x:Key="DateToPixel"/>
        <conv:DurationToWidthConverter x:Key="DurationToWidth"/>
        <conv:ProgressToWidthConverter x:Key="ProgressToWidth"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <DataGrid Grid.Column="0"
                  ItemsSource="{Binding Bars}"
                  AutoGenerateColumns="False"
                  HeadersVisibility="Column"
                  CanUserAddRows="False"
                  RowHeight="32"
                  GridLinesVisibility="Horizontal">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="160"/>
                <DataGridTextColumn Header="Start" Binding="{Binding StartDate, StringFormat=yyyy-MM-dd}" Width="80"/>
                <DataGridTextColumn Header="End" Binding="{Binding EndDate, StringFormat=yyyy-MM-dd}" Width="80"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <ScrollViewer Grid.Row="0" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          x:Name="HeaderScroll">
                <gantt:TimelineHeader x:Name="Timeline"
                                       RangeStart="{Binding RangeStart}"
                                       RangeEnd="{Binding RangeEnd}"
                                       PixelsPerDay="{Binding PixelsPerDay}"/>
            </ScrollViewer>

            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                          x:Name="BarsScroll"
                          ScrollChanged="BarsScroll_ScrollChanged">
                <ItemsControl ItemsSource="{Binding Bars}"
                              gantt:GanttCanvas.PixelsPerDay="{Binding PixelsPerDay}"
                              gantt:GanttCanvas.RangeStart="{Binding RangeStart}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <Canvas Background="White"
                                    Width="{Binding TotalWidth}"
                                    Height="{Binding TotalHeight}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="gantt:GanttCanvas.StartDate" Value="{Binding StartDate}"/>
                            <Setter Property="gantt:GanttCanvas.EndDate" Value="{Binding EndDate}"/>
                            <Setter Property="gantt:GanttCanvas.RowIndex" Value="{Binding RowIndex}"/>
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Title}">
                                <Border CornerRadius="3" BorderBrush="DarkSlateGray" BorderThickness="1"
                                        Background="LightSteelBlue">
                                    <Rectangle HorizontalAlignment="Left" Fill="SteelBlue">
                                        <Rectangle.Width>
                                            <MultiBinding Converter="{StaticResource ProgressToWidth}">
                                                <Binding Path="ProgressPercent"/>
                                                <Binding Path="ActualWidth"
                                                         RelativeSource="{RelativeSource FindAncestor, AncestorType=Border}"/>
                                            </MultiBinding>
                                        </Rectangle.Width>
                                    </Rectangle>
                                </Border>
                                <TextBlock Text="{Binding Title}" Margin="4,2,4,2"
                                           VerticalAlignment="Center" Foreground="Black" FontSize="11"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
